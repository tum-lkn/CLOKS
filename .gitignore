# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

*.log

network-simulator

*.prof
*.png
*.txt
!requirements.txt

simlogs/*
simdata/*

.vscode/

# Python stuff

__pycache__

old_simlogs/*
old_simdata/*
profiler/*.ipynb

conf/exporter/*.token
experiments/runs
experiments/figures
# experiments/measurements
experiments/validation_metrics*
experiments/final_metrics*
experiments/sim_performance*
experiments/scalability_performance*
experiments/bi_validation_metrics*
experiments/*.pdf

__debug*
# Python environment
.venv/
